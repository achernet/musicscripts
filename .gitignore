*.part
*.part-Frag*
*.partial
*.ytdl
*.aria2
*.crdownload
*.download
*.tmp
*.temp

# rclone and sync temporary artifacts
.rclone_cache/
.rclone-cache/
.rclone-tmp/
.rclone-trash/
*.rclonelink
*.rclone-partial
